{
  "name": "personal-markdown-preview-style",
  "displayName": "Personal Markdown Preview Style",
  "description": "Personal styling for VS Code's built-in Markdown preview",
  "version": "1.0.5",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allannk/personal-markdown-preview-style"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "scripts": {
    "package": "npx @vscode/vsce package"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./preview.css"
    ]
  },
  "dependencies": {
    "markdown-it-task-lists": "^2.1.1"
  }
}
